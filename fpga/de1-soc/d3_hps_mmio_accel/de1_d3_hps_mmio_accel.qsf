set_global_assignment -name FAMILY "Cyclone V"
set_global_assignment -name DEVICE 5CSEMA5F31C6
set_global_assignment -name TOP_LEVEL_ENTITY de1_d3_hps_mmio_accel
set_global_assignment -name VERILOG_FILE rtl/de1_d3_hps_mmio_accel.v
set_global_assignment -name SDC_FILE de1_d3_hps_mmio_accel.sdc
set_global_assignment -name QSYS_FILE d3_hps_mmio_system.qsys
set_global_assignment -name QIP_FILE d3_hps_mmio_system/synthesis/d3_hps_mmio_system.qip
set_global_assignment -name PROJECT_OUTPUT_DIRECTORY output_files
set_global_assignment -name RESERVE_ALL_UNUSED_PINS "AS INPUT TRI-STATED"
set_global_assignment -name NUM_PARALLEL_PROCESSORS 8

# DE1-SoC clock, reset button, red LEDs, and HEX displays.
# Source: Quartus 25.1 bundled DE1_SoC_Board platform.
set_location_assignment PIN_AF14 -to CLOCK_50

